---
import { SITE_TITLE } from "../../config";
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro";
import Body from "@components/Body.astro";
import Footer from "@components/Footer.astro";
import WorksContent from "./worksContent";
import { ClientRouter } from "astro:transitions";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description="WORKS" />
    <style>
      p {
        margin-top: 10px;
      }
    </style>
    <ClientRouter />
  </head>

  <Header />
  <Body>
    <main class="mx-[5%] flex flex-col gap-5" aria-label="home page">
      <div class="self-start underline underline-offset-8 text-xl font-semibold">WORK</div>
      <WorksContent client:only="react" />
    </main>
    <Footer />
  </Body>
</html>
