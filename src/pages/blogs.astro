---
import BaseHead from "../components/BaseHead.astro";
import Header from "@components/Header.astro";
import Body from "@components/Body.astro";
import Footer from "@components/Footer.astro";
import { SITE_TITLE } from "../config";
import { getCollection } from "astro:content";

const posts: any[] = Object.values(
  import.meta.glob("./blog/*.{md,mdx}", { eager: true })
);
console.log({ posts });
// const posts = await getCollection("blogs");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description="BLOG" />
    <style>
      ul {
        list-style-type: none;
        padding: unset;
      }
      ul li {
        display: flex;
      }
      ul li time {
        flex: 0 0 130px;
        font-style: italic;
        color: #595959;
      }
    </style>
  </head>

  <Header />

  <Body>
    <main id="blog" class="mx-[10%] mobile:mx-5 inline-flex flex-col">
      <div class="flex flex-col items-start w-[25%]">
        <h1 class="font-black text-2xl pt-5 pb-1" aria-label="blog">Blog</h1>
        <div class="w-[5rem] self-start mb-1 h-1 bg-gray-600"></div>
      </div>
      <section>
        <ul
          class="grid grid-cols-2 mobile:grid-cols-none mobile:mx-2 place-content-center"
        >
          {
            posts.map((post) => (
              <li class="p-5 inline-flex flex-col items-center">
                <a href={post.url}>
                  <div class="p-2 max-w-[40rem] object-contain">
                    {post.frontmatter.heroImage ? (
                      <img
                        alt="titleImage"
                        class="border rounded-xl border-white"
                        src={post.frontmatter.heroImage}
                      />
                    ) : null}

                    <p class="text-xl font-bold">{post.frontmatter.title}</p>

                    <time
                      class="text-gray-500"
                      datetime={post.frontmatter.pubDate}
                    >
                      {new Date(post.frontmatter.pubDate).toDateString()}
                    </time>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </Body>


</html>
