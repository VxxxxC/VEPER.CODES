---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE } from "../config";
import Header from "@components/Header.astro";
import Body from "@components/Body.astro";
import Footer from "@components/Footer.astro";
import ProjectPost from "./project/projectPosts";
import { ClientRouter } from "astro:transitions";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description="HOME" />
    <ClientRouter />
  </head>

  <Header />
  <Body>
    <main class="mx-[10%]" aria-label="project page">
      <div class="flex flex-col items-start w-[25%]">
        <h1 class="font-black text-2xl pt-5 pb-1" aria-label="project">
          Project
        </h1>
        <div class="w-[8rem] self-start mb-1 h-1 bg-gray-600"></div>
      </div>
      <ProjectPost client:only="react" />
    </main>
    <Footer />
  </Body>
</html>
