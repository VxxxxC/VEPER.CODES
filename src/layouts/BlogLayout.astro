---
import BaseHead from "../components/BaseHead.astro";
import Body from "../components/Body.astro";
import Footer from "../components/Footer.astro";
import ReturnButton from "../components/ReturnButton";
import Header from "@components/Header.astro";

export interface Props {
  content: {
    title: string;
    description: string;
    pubDate?: string;
    updatedDate?: string;
    heroImage?: string;
  };
}

const {
  content: { title, description, pubDate, updatedDate, heroImage },
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .title {
        font-size: 1.5rem;
        margin: 0 5rem 0 5rem;
      }
      hr {
        border-top: 1px solid #ffffff14;
        margin: 2.5rem;
      }
      ul {
        list-style-type: none;
        padding: unset;
      }
      ul li {
        display: flex;
      }
      ul li time {
        flex: 0 0 130px;
        font-style: italic;
        color: #595959;
      }
    </style>
  </head>

  <Header />
  <Body>
    <div class="mx-10 mobile:m-0">
      <nav class="w-[100%] p-3 flex justify-between">
        <div>
          <ReturnButton client:only="react" />
        </div>
      </nav>
      <main>
        <article>
          <ul>
            {
              heroImage && (
                <img
                  class="inline p-5 rounded-3xl object-contain"
                  src={heroImage}
                  alt="titleImage"
                />
              )
            }
            <h1 class="title">{title}</h1>
            <li class="p-5 inline-flex flex-col items-center">
              {
                updatedDate &&
                Date.parse(updatedDate as string) >
                  Date.parse(pubDate as string)
                  ? updatedDate && (
                      <div>
                        <time>Last updated on {updatedDate}</time>
                      </div>
                    )
                  : pubDate && <time>{pubDate}</time>
              }
            </li>

            <hr />
          </ul>

          <!-- * NOTE: Content Start right here.. -->
          <slot />
        </article>
      </main>
      <Footer />
    </div>
  </Body>


</html>
