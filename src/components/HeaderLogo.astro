---
import { SITE_TITLE } from "../config";
---

<style>
  .neonText {
    animation: flicker 1.5s infinite alternate;
    color: #fff;
  }

  /* Flickering animation */
  @keyframes flicker {
    0%,
    18%,
    22%,
    25%,
    53%,
    57%,
    100% {
      text-shadow: 0 0 4px #fff, 0 0 11px #fff, 0 0 19px #fff, 0 0 40px #00e6ff,
        0 0 80px #00e6ff, 0 0 90px #00e6ff, 0 0 100px #00e6ff, 0 0 150px #00e6ff;
    }

    20%,
    24%,
    55% {
      text-shadow: none;
    }
  }
</style>

<h1 class="neonText relative mb-20 text-4xl" aria-label="header logo">
  {SITE_TITLE}
</h1>
